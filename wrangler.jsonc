{
  "name": "relocation1v",
  // Cloudflare account that owns this Worker (Dev@quanta.ge). Not secret; lets CI
  // deploy without an accountId input. The API token is the only secret needed.
  "account_id": "df161cb8bd90d83e39c31aeca74ff386",
  "compatibility_date": "2025-05-01",
  // The Worker serves the static site AND one dynamic endpoint (/api/match).
  // Everything except /api/* falls through to the built assets, so the site
  // stays static in every respect that matters.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    // Binding lets the Worker hand ordinary requests back to the static assets.
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
  // Secret required by /api/match (set once, never committed):
  //   npx wrangler secret put ANTHROPIC_API_KEY
  // Without it the endpoint returns 503 and the page falls back to the
  // deterministic keyword search — the site keeps working.
}
