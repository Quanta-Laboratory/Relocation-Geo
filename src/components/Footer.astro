---
const support = [
  { href: '/en/methodology', label: 'Methodology' },
  { href: '/en/data-integrity-standard', label: 'Data Integrity Standard' },
  { href: '/en/use-of-materials', label: 'Use of Materials' },
  { href: '/en/ai-compliance-disclosure', label: 'AI Compliance Disclosure' },
  { href: '/sitemap-index.xml', label: 'Sitemap' },
  // AGPL-3.0 §13: a public deployment must offer users the source.
  { href: 'https://github.com/Quanta-Laboratory/Relocation-Geo', label: 'Source code (AGPL-3.0)', external: true },
];
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <h3>Support links</h3>
    <ul>
      {support.map((s) => (
        <li>
          {s.external
            ? <a href={s.href} target="_blank" rel="noopener noreferrer" class="source-link">
                <svg class="gh-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                <span>{s.label}</span>
              </a>
            : <a href={s.href}>{s.label}</a>}
        </li>
      ))}
    </ul>
    <div class="non-commercial">
      <a
        class="emblem-link"
        href="https://www.heraldika.ge/?lng=eng"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="National emblem of Georgia — State Council of Heraldry at the Parliament of Georgia"
      >
        <img
          src="/coat-of-arms-georgia.webp"
          alt="National emblem of Georgia"
          width="46"
          height="40"
          loading="lazy"
        />
      </a>
      <p>Relocation.ge is a <strong>non-governmental, privately-run initiative</strong>.</p>
    </div>
    <p class="disclaimer">
      Relocation.ge is an independent, privately-run open-source project. It is not
      affiliated with, or endorsed by, any government body. Information is structured
      from publicly available official publications. © Relocation.ge.
    </p>
  </div>
</footer>

<style>
  .site-footer .non-commercial {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.25rem 0 0.75rem;
    font-size: 0.95rem;
  }
  .site-footer .non-commercial p {
    margin: 0;
  }
  .site-footer .emblem-link {
    display: inline-flex;
    flex: none;
    line-height: 0;
  }
  .site-footer .emblem-link img {
    display: block;
    height: 40px;
    width: auto;
    background: transparent;
  }
  .site-footer .source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .site-footer .gh-icon {
    flex: none;
    vertical-align: middle;
  }
</style>
