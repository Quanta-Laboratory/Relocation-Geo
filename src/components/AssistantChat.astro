---
// Site assistant widget: a floating "Ask a question" button that opens a chat
// answered by /api/chat (worker/assistant.ts) from relocation.ge's own guides,
// with a hand-off to the team on Telegram / WhatsApp.
//
// GA4 events (sent only if gtag is loaded, i.e. after analytics consent):
//   assistant_open, assistant_message {count}, assistant_handoff {channel, trigger},
//   generate_lead {method} — mark generate_lead as a key event in GA4.
// The conversation lives in sessionStorage for the tab only; nothing is stored
// server-side.
const { lang = 'en' } = Astro.props;

const TELEGRAM = 'https://t.me/mono_ge';
const WHATSAPP = 'https://wa.me/995599799810';

const T: Record<string, Record<string, string>> = {
  en: {
    launch: 'Ask a question', title: 'Relocation.ge assistant',
    hello: "Hi! Ask me about visas, residence permits, the right to work, taxes, IE registration or banking in Georgia. I answer from this site's guides, with links to the sources.",
    placeholder: 'Type your question…', send: 'Send', thinking: 'Looking through the guides…',
    human: 'Talk to a person', humanHint: 'Our team can help with this:',
    sources: 'Sources', error: 'Something went wrong. Please try again or contact us directly.',
    limited: 'Too many messages — please wait a minute.', close: 'Close', reset: 'New chat',
    note: 'Information from relocation.ge, not legal advice.', prefill: 'Hello! I came from relocation.ge.',
    s1: 'How long can I stay without a visa?', s2: 'How do I register as an IE remotely?', s3: 'Do I need a permit to work?',
  },
  ru: {
    launch: 'Задать вопрос', title: 'Ассистент Relocation.ge',
    hello: 'Здравствуйте! Спросите о визах, ВНЖ, праве на работу, налогах, регистрации ИП или банках в Грузии. Отвечаю по материалам сайта со ссылками на источники.',
    placeholder: 'Ваш вопрос…', send: 'Отправить', thinking: 'Ищу в материалах сайта…',
    human: 'Связаться с человеком', humanHint: 'С этим поможет наша команда:',
    sources: 'Источники', error: 'Что-то пошло не так. Попробуйте ещё раз или напишите нам напрямую.',
    limited: 'Слишком много сообщений — подождите минуту.', close: 'Закрыть', reset: 'Новый чат',
    note: 'Информация с relocation.ge, не юридическая консультация.', prefill: 'Здравствуйте! Я с сайта relocation.ge.',
    s1: 'Сколько можно находиться в Грузии без визы?', s2: 'Как зарегистрировать ИП удалённо?', s3: 'Нужно ли разрешение на работу?',
  },
  uk: {
    launch: 'Поставити питання', title: 'Асистент Relocation.ge',
    hello: 'Вітаю! Запитайте про візи, посвідку на проживання, право на роботу, податки, реєстрацію ФОП (IE) чи банки в Грузії. Відповідаю за матеріалами сайту з посиланнями на джерела.',
    placeholder: 'Ваше питання…', send: 'Надіслати', thinking: 'Шукаю в матеріалах сайту…',
    human: 'Звʼязатися з людиною', humanHint: 'З цим допоможе наша команда:',
    sources: 'Джерела', error: 'Щось пішло не так. Спробуйте ще раз або напишіть нам напряму.',
    limited: 'Забагато повідомлень — зачекайте хвилину.', close: 'Закрити', reset: 'Новий чат',
    note: 'Інформація з relocation.ge, не юридична консультація.', prefill: 'Вітаю! Я з сайту relocation.ge.',
    s1: 'Скільки можна перебувати в Грузії без візи?', s2: 'Як зареєструвати IE дистанційно?', s3: 'Чи потрібен дозвіл на роботу?',
  },
  ka: {
    launch: 'დასვით კითხვა', title: 'Relocation.ge ასისტენტი',
    hello: 'გამარჯობა! მკითხეთ ვიზების, ბინადრობის ნებართვის, მუშაობის უფლების, გადასახადების, ინდმეწარმის რეგისტრაციის ან ბანკების შესახებ. ვპასუხობ საიტის მასალებით, წყაროების ბმულებით.',
    placeholder: 'თქვენი კითხვა…', send: 'გაგზავნა', thinking: 'ვეძებ საიტის მასალებში…',
    human: 'დაუკავშირდით ადამიანს', humanHint: 'ამაში ჩვენი გუნდი დაგეხმარებათ:',
    sources: 'წყაროები', error: 'რაღაც შეცდომა მოხდა. სცადეთ ხელახლა ან მოგვწერეთ პირდაპირ.',
    limited: 'ძალიან ბევრი შეტყობინება — დაელოდეთ ერთ წუთს.', close: 'დახურვა', reset: 'ახალი ჩატი',
    note: 'ინფორმაცია relocation.ge-დან, არა იურიდიული კონსულტაცია.', prefill: 'გამარჯობა! relocation.ge-დან ვარ.',
    s1: 'რამდენ ხანს შემიძლია ვიყო ვიზის გარეშე?', s2: 'როგორ დავრეგისტრირდე ინდმეწარმედ დისტანციურად?', s3: 'მჭირდება თუ არა მუშაობის ნებართვა?',
  },
  de: {
    launch: 'Frage stellen', title: 'Relocation.ge-Assistent',
    hello: 'Hallo! Fragen Sie mich zu Visa, Aufenthaltstiteln, Arbeitserlaubnis, Steuern, Einzelunternehmer-Registrierung oder Banken in Georgien. Ich antworte aus den Leitfäden dieser Website, mit Quellenlinks.',
    placeholder: 'Ihre Frage…', send: 'Senden', thinking: 'Ich durchsuche die Leitfäden…',
    human: 'Mit einem Menschen sprechen', humanHint: 'Dabei hilft Ihnen unser Team:',
    sources: 'Quellen', error: 'Etwas ist schiefgelaufen. Bitte erneut versuchen oder uns direkt schreiben.',
    limited: 'Zu viele Nachrichten — bitte eine Minute warten.', close: 'Schließen', reset: 'Neuer Chat',
    note: 'Informationen von relocation.ge, keine Rechtsberatung.', prefill: 'Hallo! Ich komme von relocation.ge.',
    s1: 'Wie lange darf ich ohne Visum bleiben?', s2: 'Wie registriere ich mich aus der Ferne als Einzelunternehmer?', s3: 'Brauche ich eine Arbeitserlaubnis?',
  },
  fr: {
    launch: 'Poser une question', title: 'Assistant Relocation.ge',
    hello: "Bonjour ! Posez-moi vos questions sur les visas, les titres de séjour, le droit de travailler, les impôts, l'enregistrement d'entrepreneur individuel ou les banques en Géorgie. Je réponds à partir des guides du site, avec les sources.",
    placeholder: 'Votre question…', send: 'Envoyer', thinking: 'Je consulte les guides…',
    human: 'Parler à une personne', humanHint: 'Notre équipe peut vous aider :',
    sources: 'Sources', error: 'Une erreur est survenue. Réessayez ou écrivez-nous directement.',
    limited: 'Trop de messages — patientez une minute.', close: 'Fermer', reset: 'Nouveau chat',
    note: "Informations de relocation.ge, pas un conseil juridique.", prefill: 'Bonjour ! Je viens de relocation.ge.',
    s1: 'Combien de temps puis-je rester sans visa ?', s2: "Comment s'enregistrer comme entrepreneur individuel à distance ?", s3: 'Faut-il un permis pour travailler ?',
  },
  he: {
    launch: 'שאלו שאלה', title: 'העוזר של Relocation.ge',
    hello: 'שלום! שאלו אותי על ויזות, היתרי שהייה, הזכות לעבוד, מיסים, רישום עוסק או בנקים בגאורגיה. אני עונה מתוך המדריכים באתר, עם קישורים למקורות.',
    placeholder: 'השאלה שלכם…', send: 'שליחה', thinking: 'מחפש במדריכים…',
    human: 'דברו עם אדם', humanHint: 'הצוות שלנו יכול לעזור בזה:',
    sources: 'מקורות', error: 'משהו השתבש. נסו שוב או כתבו לנו ישירות.',
    limited: 'יותר מדי הודעות — המתינו דקה.', close: 'סגירה', reset: 'צ׳אט חדש',
    note: 'מידע מ-relocation.ge, לא ייעוץ משפטי.', prefill: 'שלום! הגעתי מ-relocation.ge.',
    s1: 'כמה זמן אפשר לשהות בלי ויזה?', s2: 'איך נרשמים כעוסק מרחוק?', s3: 'האם צריך היתר עבודה?',
  },
};
const t = T[lang] ?? T.en;
const cfg = { lang: T[lang] ? lang : 'en', t, TELEGRAM, WHATSAPP };
---
<div class="ra" data-open="false" hidden>
  <section class="ra-panel" id="ra-panel" role="dialog" aria-label={t.title} hidden>
    <header class="ra-head">
      <strong>{t.title}</strong>
      <div class="ra-head-actions">
        <button type="button" class="ra-icon" id="ra-reset" title={t.reset} aria-label={t.reset}>↺</button>
        <button type="button" class="ra-icon" id="ra-close" title={t.close} aria-label={t.close}>✕</button>
      </div>
    </header>
    <div class="ra-log" id="ra-log" aria-live="polite"></div>
    <div class="ra-human">
      <span>{t.human}:</span>
      <a class="ra-tg" data-channel="telegram" href={TELEGRAM} target="_blank" rel="noopener">Telegram</a>
      <a class="ra-wa" data-channel="whatsapp" href={WHATSAPP} target="_blank" rel="noopener">WhatsApp</a>
    </div>
    <form class="ra-form" id="ra-form">
      <textarea id="ra-input" rows="1" maxlength="1500" placeholder={t.placeholder} aria-label={t.placeholder}></textarea>
      <button type="submit" id="ra-send">{t.send}</button>
    </form>
    <p class="ra-note">{t.note}</p>
  </section>
  <button type="button" class="ra-launch" id="ra-launch" aria-controls="ra-panel" aria-expanded="false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 00-2 2v18l4-4h14a2 2 0 002-2V4a2 2 0 00-2-2zm-9 13H7v-2h4v2zm6-4H7V9h10v2zm0-4H7V5h10v2z"/></svg>
    <span>{t.launch}</span>
  </button>
</div>

<script is:inline define:vars={{ cfg }}>
(function () {
  var t = cfg.t, KEY = 'ra-chat-v1';
  var root = document.querySelector('.ra'), panel = document.getElementById('ra-panel');
  var log = document.getElementById('ra-log'), form = document.getElementById('ra-form');
  var input = document.getElementById('ra-input'), send = document.getElementById('ra-send');
  var launch = document.getElementById('ra-launch');
  if (!root || !panel) return;

  var state = { open: false, messages: [], opened: false };
  try { var saved = JSON.parse(sessionStorage.getItem(KEY) || 'null'); if (saved && Array.isArray(saved.messages)) state = saved; } catch (e) {}
  function save() { try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }
  function track(name, params) { try { if (typeof window.gtag === 'function') window.gtag('event', name, params || {}); } catch (e) {} }

  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function inline(s) {
    return esc(s)
      .replace(/\[([^\]]+)\]\((https:\/\/[^\s)]+)\)/g, function (_, txt, url) {
        var own = /^https:\/\/relocation\.ge\//.test(url);
        return '<a href="' + url + '"' + (own ? '' : ' target="_blank" rel="noopener"') + '>' + txt + '</a>';
      })
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  }
  function md(text) {
    var out = [], list = null;
    String(text).split('\n').forEach(function (line) {
      var m = line.match(/^\s*(?:[-*•]|\d+[.)])\s+(.*)$/);
      if (m) { if (!list) { list = []; } list.push('<li>' + inline(m[1]) + '</li>'); return; }
      if (list) { out.push('<ul>' + list.join('') + '</ul>'); list = null; }
      if (line.trim()) out.push('<p>' + inline(line.replace(/^#+\s*/, '')) + '</p>');
    });
    if (list) out.push('<ul>' + list.join('') + '</ul>');
    return out.join('');
  }
  function withText(url, text) { return url + (url.indexOf('?') < 0 ? '?' : '&') + 'text=' + encodeURIComponent(text); }
  function prefill(topic) { return t.prefill + (topic ? ' ' + topic : '') + '\n' + location.href; }

  function bubble(m) {
    var el = document.createElement('div');
    el.className = 'ra-msg ra-' + m.role;
    if (m.role === 'user') el.textContent = m.content; else el.innerHTML = md(m.content);
    if (m.sources && m.sources.length) {
      var s = document.createElement('div'); s.className = 'ra-sources';
      s.innerHTML = '<span>' + esc(t.sources) + ':</span> ' + m.sources.map(function (x) { return '<a href="' + esc(x.url) + '">' + esc(x.title) + '</a>'; }).join(' · ');
      el.appendChild(s);
    }
    if (m.handoff) {
      var h = document.createElement('div'); h.className = 'ra-handoff';
      var msg = prefill(m.handoff.topic);
      h.innerHTML = '<span>' + esc(t.humanHint) + '</span>' +
        '<a class="ra-tg" data-channel="telegram" data-trigger="suggested" target="_blank" rel="noopener" href="' + esc(withText(cfg.TELEGRAM, msg)) + '">Telegram</a>' +
        '<a class="ra-wa" data-channel="whatsapp" data-trigger="suggested" target="_blank" rel="noopener" href="' + esc(withText(cfg.WHATSAPP, msg)) + '">WhatsApp</a>';
      el.appendChild(h);
    }
    log.appendChild(el);
    return el;
  }
  function suggestions() {
    var box = document.createElement('div'); box.className = 'ra-suggest';
    [t.s1, t.s2, t.s3].forEach(function (q) {
      var b = document.createElement('button'); b.type = 'button'; b.textContent = q;
      b.addEventListener('click', function () { ask(q); });
      box.appendChild(b);
    });
    log.appendChild(box);
  }
  function render() {
    log.innerHTML = '';
    bubble({ role: 'assistant', content: t.hello });
    if (!state.messages.length) suggestions();
    state.messages.forEach(bubble);
    log.scrollTop = log.scrollHeight;
  }
  function setOpen(open) {
    state.open = open; save();
    panel.hidden = !open; root.setAttribute('data-open', String(open));
    launch.setAttribute('aria-expanded', String(open));
    if (open) {
      render(); setTimeout(function () { input.focus(); }, 50);
      if (!state.opened) { state.opened = true; save(); }
      track('assistant_open');
    }
  }

  var busy = false;
  async function ask(text) {
    text = String(text || '').trim();
    if (!text || busy) return;
    busy = true; send.disabled = true; input.value = ''; autosize();
    var sug = log.querySelector('.ra-suggest'); if (sug) sug.remove();
    state.messages.push({ role: 'user', content: text }); save();
    bubble({ role: 'user', content: text });
    var wait = bubble({ role: 'assistant', content: t.thinking }); wait.classList.add('ra-wait');
    log.scrollTop = log.scrollHeight;
    track('assistant_message', { count: state.messages.filter(function (m) { return m.role === 'user'; }).length });
    var reply;
    try {
      var res = await fetch('/api/chat', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          lang: cfg.lang, page: location.pathname,
          messages: state.messages.map(function (m) { return { role: m.role, content: m.content }; }),
        }),
      });
      var data = await res.json().catch(function () { return {}; });
      if (res.ok && data.reply) reply = { role: 'assistant', content: data.reply, sources: data.sources || [], handoff: data.handoff || null };
      else reply = { role: 'assistant', content: res.status === 429 ? t.limited : t.error, error: true };
    } catch (e) { reply = { role: 'assistant', content: t.error, error: true }; }
    wait.remove();
    if (reply.error) { state.messages.pop(); input.value = text; } else { state.messages.push(reply); }
    save(); bubble(reply);
    if (reply.handoff) track('assistant_handoff_offered', { topic: String(reply.handoff.topic || '').slice(0, 100) });
    log.scrollTop = log.scrollHeight;
    busy = false; send.disabled = false; input.focus();
  }

  function autosize() { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 140) + 'px'; }
  input.addEventListener('input', autosize);
  input.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); ask(input.value); } });
  form.addEventListener('submit', function (e) { e.preventDefault(); ask(input.value); });
  launch.addEventListener('click', function () { setOpen(!state.open); });
  document.getElementById('ra-close').addEventListener('click', function () { setOpen(false); });
  document.getElementById('ra-reset').addEventListener('click', function () { state.messages = []; save(); render(); input.focus(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && state.open) setOpen(false); });
  panel.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[data-channel]');
    if (!a) return;
    var p = { channel: a.getAttribute('data-channel'), trigger: a.getAttribute('data-trigger') || 'header' };
    track('assistant_handoff', p);
    track('generate_lead', { method: p.channel, lead_source: 'assistant_' + p.trigger });
  });
  // Header links: prefill WhatsApp/Telegram with the page the visitor is on.
  panel.querySelectorAll('.ra-human a').forEach(function (a) { a.href = withText(a.getAttribute('href'), prefill('')); });

  // Show the widget only when the assistant is configured (cached per tab).
  function reveal() { root.hidden = false; if (state.open) setOpen(true); }
  var avail = null; try { avail = sessionStorage.getItem('ra-available'); } catch (e) {}
  if (avail === '1') reveal();
  else if (avail !== '0') {
    fetch('/api/chat').then(function (r) { return r.json(); }).then(function (d) {
      try { sessionStorage.setItem('ra-available', d && d.available ? '1' : '0'); } catch (e) {}
      if (d && d.available) reveal();
    }).catch(function () {});
  }
})();
</script>

<style>
  .ra[hidden] { display: none; }
  .ra { position: fixed; inset-inline-end: 20px; bottom: 20px; z-index: 900; font-size: 16px; line-height: 1.45; }
  .ra-launch { display: flex; align-items: center; gap: 8px; padding: 12px 18px; border: 0; border-radius: 999px;
    background: var(--blue, #1d70b8); color: #fff; font: 600 16px/1 var(--font-sans, sans-serif); cursor: pointer;
    box-shadow: 0 4px 14px rgba(0,0,0,.22); margin-inline-start: auto; }
  .ra-launch svg { width: 20px; height: 20px; }
  .ra-launch:hover { background: var(--blue-dark, #003078); }
  .ra-launch:focus-visible, .ra button:focus-visible, .ra a:focus-visible { outline: 3px solid var(--yellow, #fd0); outline-offset: 2px; }
  .ra[data-open="true"] .ra-launch { display: none; }
  .ra-panel { width: min(400px, calc(100vw - 24px)); height: min(620px, calc(100vh - 40px)); display: flex; flex-direction: column;
    background: #fff; color: var(--black, #0b0c0c); border: 1px solid var(--grey-2, #b1b4b6); border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,.25); overflow: hidden; }
  .ra-panel[hidden] { display: none; }
  .ra-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px;
    background: var(--navy, #12436d); color: #fff; }
  .ra-head-actions { display: flex; gap: 4px; }
  .ra-icon { background: transparent; border: 0; color: #fff; font-size: 18px; width: 32px; height: 32px; border-radius: 6px; cursor: pointer; }
  .ra-icon:hover { background: rgba(255,255,255,.15); }
  .ra-log { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
  .ra-msg { max-width: 92%; padding: 10px 12px; border-radius: 10px; word-wrap: break-word; }
  .ra-msg p { margin: 0 0 6px; } .ra-msg p:last-child { margin-bottom: 0; }
  .ra-msg ul { margin: 4px 0 6px; padding-inline-start: 20px; }
  .ra-assistant { background: var(--grey-3, #f3f2f1); align-self: flex-start; }
  .ra-user { background: var(--blue, #1d70b8); color: #fff; align-self: flex-end; white-space: pre-wrap; }
  .ra-wait { opacity: .7; font-style: italic; }
  .ra-sources { margin-top: 8px; font-size: 13px; color: var(--grey-1, #505a5f); }
  .ra-handoff, .ra-human { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .ra-handoff { margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--grey-2, #b1b4b6); font-size: 14px; }
  .ra-handoff span { flex-basis: 100%; }
  .ra-human { padding: 8px 14px; font-size: 13px; color: var(--grey-1, #505a5f); border-top: 1px solid var(--grey-4, #e7e6e5); }
  .ra-tg, .ra-wa { padding: 6px 12px; border-radius: 999px; color: #fff !important; text-decoration: none; font-weight: 600; font-size: 14px; }
  .ra-tg { background: #229ed9; } .ra-wa { background: #1fa855; }
  .ra-tg:hover, .ra-wa:hover { filter: brightness(.92); }
  .ra-suggest { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .ra-suggest button { text-align: start; background: #fff; border: 1px solid var(--blue, #1d70b8); color: var(--blue, #1d70b8);
    border-radius: 999px; padding: 6px 12px; font: 14px/1.3 var(--font-sans, sans-serif); cursor: pointer; }
  .ra-suggest button:hover { background: var(--blue, #1d70b8); color: #fff; }
  .ra-form { display: flex; gap: 8px; padding: 10px 14px 4px; }
  .ra-form textarea { flex: 1; resize: none; border: 2px solid var(--black, #0b0c0c); border-radius: 8px; padding: 8px 10px;
