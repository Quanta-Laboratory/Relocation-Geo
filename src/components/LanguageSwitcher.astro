---
// Language switcher shown in the site header. Renders only when the current
// page has translations. No JavaScript: it uses a native <details> disclosure.
//
// Props:
//   links: { code, native, href, active }[]  — one per available language
//   label: string                            — accessible label ("Language")
const { links = [], label = 'Language' } = Astro.props;
const current = links.find((l: { active: boolean }) => l.active);
---
{links.length > 1 && (
  <details class="langsw">
    <summary aria-label={label} title={label}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9s1.3-6.5 3.8-9z" />
      </svg>
      <span>{current ? current.native : label}</span>
      <svg class="langsw__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </summary>
    <ul>
      {links.map((l: { code: string; native: string; href: string; active: boolean }) => (
        <li>
          <a href={l.href} lang={l.code} hreflang={l.code} aria-current={l.active ? 'true' : undefined}>
            {l.native}
          </a>
        </li>
      ))}
    </ul>
  </details>
)}

<style is:global>
  .langsw {
    position: relative;
    margin-inline-start: 8px;
  }
  .langsw > summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: transparent;
    color: #fff;
    border: 1px solid #6f777b;
    border-radius: 4px;
    padding: 7px 10px;
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
  }
  .langsw > summary::-webkit-details-marker { display: none; }
  .langsw > summary:hover { background: #2e3133; }
  .langsw > summary:focus-visible { outline: 3px solid var(--yellow); outline-offset: 2px; }
  .langsw svg { width: 18px; height: 18px; flex: none; }
  .langsw__caret { width: 14px; height: 14px; opacity: 0.8; }
  .langsw[open] .langsw__caret { transform: rotate(180deg); }

  .langsw ul {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 6px);
    margin: 0;
    padding: 6px;
    list-style: none;
    min-width: 180px;
    background: #1a1d1f;
    border: 1px solid #3a3f43;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    z-index: 50;
  }
  .langsw li { margin: 0; }
  .langsw ul a {
    display: block;
    padding: 9px 12px;
    border-radius: 4px;
    color: #e9ebed;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
  }
  .langsw ul a:hover { background: #2a2e31; }
  .langsw ul a[aria-current="true"] {
    color: #fff;
    background: #2a2e31;
    font-weight: 800;
  }

  @media (max-width: 560px) {
    .langsw > summary span { display: none; }
  }
</style>
