---
const {
  reviewed,
  checked,
  locale = 'en-GB',
  reviewedLabel = 'Last reviewed',
  checkedLabel = 'Last checked',
} = Astro.props;
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' });
---
<p class="datestamp">
  {reviewedLabel}: <strong>{fmt(reviewed)}</strong> · {checkedLabel}: {fmt(checked)}
</p>
