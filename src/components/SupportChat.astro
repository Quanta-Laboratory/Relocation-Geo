---
// Support speed-dial: a floating "Support" button that reveals contact options.
// Telegram + WhatsApp are simple links. "Live chat" lazy-loads Chatwoot only on
// first click (keeps Core Web Vitals high) and is shown only when Chatwoot env
// vars are set, so the site works fine before chat is configured.
const TELEGRAM_URL = 'https://t.me/mono_ge';
const WHATSAPP_URL = 'https://wa.me/995599799810';

// Works for Chatwoot Cloud (https://app.chatwoot.com) or self-hosted (your URL).
const CHATWOOT_BASE_URL = import.meta.env.PUBLIC_CHATWOOT_BASE_URL || '';
const CHATWOOT_TOKEN = import.meta.env.PUBLIC_CHATWOOT_TOKEN || '';
const chatEnabled = Boolean(CHATWOOT_BASE_URL && CHATWOOT_TOKEN);
---
<div class="support-fab" data-open="false">
  <div class="support-options" id="support-options" role="menu">
    <a class="support-option support-tg" href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" role="menuitem" aria-label="Contact us on Telegram">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71l-4.14-3.05-1.99 1.93c-.23.23-.42.42-.83.42z"/>
      </svg>
    </a>
    <a class="support-option support-wa" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" role="menuitem" aria-label="Contact us on WhatsApp">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </a>
    {chatEnabled && (
      <button class="support-option support-chat" id="support-chat" type="button" role="menuitem" aria-label="Start a live chat">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20 2H4a2 2 0 00-2 2v18l4-4h14a2 2 0 002-2V4a2 2 0 00-2-2zM7 9h10v2H7V9zm6 4H7v-2h6v2zm4-6H7V5h10v2z"/>
        </svg>
      </button>
    )}
  </div>
  <button id="support-launch" type="button" aria-expanded="false" aria-controls="support-options">
    Support
  </button>
</div>

<script is:inline define:vars={{ CHATWOOT_BASE_URL, CHATWOOT_TOKEN }}>
  (function () {
    var fab = document.querySelector('.support-fab');
    var btn = document.getElementById('support-launch');
    if (!fab || !btn) return;

    function setOpen(open) {
      fab.setAttribute('data-open', open ? 'true' : 'false');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(fab.getAttribute('data-open') !== 'true');
    });
    document.addEventListener('click', function (e) {
      if (!fab.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });

    // --- Lazy Chatwoot loader (only when configured) ---
    var chatBtn = document.getElementById('support-chat');
    if (chatBtn && CHATWOOT_BASE_URL && CHATWOOT_TOKEN) {
      var loading = false;
      function openChat() {
        if (window.$chatwoot) { window.$chatwoot.toggle('open'); return; }
        if (loading) return;
        loading = true;
        window.chatwootSettings = { hideMessageBubble: true, position: 'right', locale: 'en' };
        window.addEventListener('chatwoot:ready', function () { window.$chatwoot.toggle('open'); });
        var g = document.createElement('script');
        g.src = CHATWOOT_BASE_URL + '/packs/js/sdk.js';
        g.async = true;
        g.defer = true;
        g.onload = function () {
          window.chatwootSDK.run({ websiteToken: CHATWOOT_TOKEN, baseUrl: CHATWOOT_BASE_URL });
        };
        document.head.appendChild(g);
      }
      chatBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        setOpen(false);
        openChat();
      });
    }
  })();
</script>
