---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const checked = new Date().toISOString().slice(0, 10);
const DATA_AS_OF = '2026-10-09';
const curY = new Date().getFullYear();
const taxYears = [curY - 1, curY];

// Municipal rates are set by each Sakrebulo's decree and are NOT published in one
// place; these are read from the official decrees (links below). "Other" falls
// back to the Tax Code's statutory spans. Confirmed cities only — property-tax %
// is stable; the non-agricultural land coefficient is zone-specific within a city,
// so it is given as a city range (use the Revenue Service Land Calculator for an
// exact parcel figure). Date-stamped; decrees are typically amended each year.
const municipalities = [
  { code: 'tbilisi', name: 'Tbilisi', propertyRate: 0.008, landMin: 1.0, landMax: 1.5, decree: 'https://matsne.gov.ge/ka/document/view/2668661', asOf: '2025-12', note: 'Non-agricultural land coefficient is set by neighbourhood (16 zones, 1.0–1.5).' },
  { code: 'batumi', name: 'Batumi', propertyRate: 0.008, landMin: 0.7, landMax: 1.3, decree: 'https://www.batumi.ge', asOf: '2024', note: 'Land coefficient by zone (central 1.3 / middle 1.0 / outer 0.7). Verify the current matsne version.' },
  { code: 'kutaisi', name: 'Kutaisi', propertyRate: 0.008, landMin: 0.25, landMax: 1.25, decree: 'https://matsne.gov.ge/ka/document/view/3556019', asOf: '2017', note: 'Land coefficient by street-level subzone (0.25 / 0.75 / 1.25).' },
  { code: 'rustavi', name: 'Rustavi', propertyRate: 0.01, landMin: 0.665, landMax: 1.05, decree: 'https://matsne.gov.ge/ka/document/view/4146797', asOf: '2018', note: 'Property-tax rate is set at the 1% ceiling.' },
  { code: 'poti', name: 'Poti', propertyRate: 0.008, landMin: 1.4, landMax: 1.4, decree: 'https://matsne.gov.ge/ka/document/view/2808167', asOf: '2024', note: 'Single city-wide land coefficient of 1.4.' },
];
const RS_LAND = 'https://www.rs.ge/LandCalculator';

const crumbs = [
  { href: '/en/', label: 'Home' },
  { href: '/en/#tax', label: 'Taxes' },
  { label: 'Property Tax Calculator' },
];

const description =
  'Build a Georgia property-tax estimate asset by asset: real estate, cars, yachts, boats, aircraft and land. Pick your income band, each item’s region, ownership dates and market value (or land area and type). Based on the Tax Code and the municipalities’ decrees. Not tax advice.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Georgia property tax calculator',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GEL' },
  description,
  isBasedOn: 'https://matsne.gov.ge/en/document/view/1043717',
};
---
<BaseLayout title="Georgia Property Tax Calculator (2026)" description={description} jsonLd={[jsonLd]}>
  <Breadcrumbs items={crumbs} />
  <main id="main" class="wrap">
    <h1>Georgia Property Tax Calculator</h1>
    <p class="lede">
      Build your estimate <strong>asset by asset</strong>. Add each property you own — real estate, a car, a
      yacht or boat, an aircraft, or land — set its region, ownership dates and value, and the calculator applies
      the <strong>Tax Code</strong>'s rules and, where known, your <strong>municipality's exact rate</strong>.
    </p>

    <div class="hub-note">
      <span class="hub-note__tag">How it works</span>
      <span>
        Property tax is a <strong>local</strong> tax. For an individual, real estate and vehicles (cars, yachts,
        boats, aircraft) are exempt if <strong>family income is GEL 100,000 or less</strong>; above that they are
        taxed at 0.8%–1% of market value. <strong>Land tax is separate</strong> and is <em>not</em> covered by that
        income exemption. Part-year ownership is pro-rated. For an exact land figure use the
        <a href={RS_LAND} target="_blank" rel="noopener noreferrer">Revenue Service calculators</a>.
      </span>
    </div>

    <!-- Global inputs -->
    <div class="pt-muni">
      <div class="pt-global">
        <label>Family income last year
          <select id="pt-income">
            <option value="le">GEL 100,000 or less</option>
            <option value="gt" selected>More than GEL 100,000</option>
          </select>
        </label>
        <label>Tax year
          <select id="pt-year">
            {taxYears.map((y, i) => <option value={y} selected={i === 0}>{y}</option>)}
          </select>
        </label>
      </div>
      <p class="pt-muni-src" id="pt-income-src"></p>
    </div>

    <!-- Asset list -->
    <div id="pt-assets"></div>
    <button type="button" id="pt-add" class="pt-add">+ Add property</button>

    <!-- Summary -->
    <section class="pt-card pt-summary" id="pt-summary" hidden>
      <h2>Estimated annual tax</h2>
      <div id="pt-summary-body"></div>
    </section>

    <p class="pt-foot-note">
      Individuals file the property-tax declaration (covering both taxable property and land) to the Revenue Service
      by <strong>1 November</strong> and pay by <strong>15 November</strong>. Taxable property is valued as at
      <strong>31 December</strong> of the previous year; land is assessed by ownership as at <strong>1 April</strong>.
      A family with more than one owner can file a single joint declaration.
    </p>

    <div class="sources">
      <strong>Sources</strong>
      <ul>
        <li><a href="https://matsne.gov.ge/en/document/view/1043717" target="_blank" rel="noopener noreferrer">Tax Code of Georgia</a> — taxable objects, rates, the GEL 100,000 exemption and part-year pro-rating (arts. 201, 202, 206; doc. 1043717)</li>
        <li><a href="https://taxsummaries.pwc.com/georgia/individual/other-taxes" target="_blank" rel="noopener noreferrer">PwC Worldwide Tax Summaries — Georgia, Individual: Other taxes</a> — objects of individual property tax (real estate, yachts, motorboats, aircraft, helicopters, cars from 2018)</li>
        <li>Municipal rates from each Sakrebulo decree: Tbilisi, Batumi, Kutaisi, Rustavi, Poti (shown per asset when you pick the region); as of {DATA_AS_OF}</li>
        <li><a href={RS_LAND} target="_blank" rel="noopener noreferrer">Revenue Service — Land / property tax calculators</a> (exact parcel figures)</li>
        <li><a href="/en/property-tax-georgia">Property tax in Georgia</a> — the full guide behind this calculator</li>
      </ul>
    </div>

    <p class="tool-foot">
      <strong>Not legal or tax advice.</strong> This is an estimate. Municipal rates are set locally, vary by
      zone, are usually re-adopted each year, and individual situations differ — confirm your actual liability
      with the <a href="https://www.rs.ge/" target="_blank" rel="noopener noreferrer">Revenue Service</a> and your
      municipality's current decree before relying on it. Municipal figures as of {DATA_AS_OF}; last checked {checked}.
    </p>
  </main>

  <script type="application/json" id="pt-muni-data" set:html={JSON.stringify(municipalities)}></script>
  <script is:inline>
    (function () {
      var MUNIS = JSON.parse(document.getElementById('pt-muni-data').textContent || '[]');
      var byCode = {};
      MUNIS.forEach(function (m) { byCode[m.code] = m; });
      var OTHER = { code: '__other', name: 'your municipality', propertyRate: null, landMin: 1.0, landMax: 1.5, decree: null, asOf: null, note: '' };
      function muni(code) { return byCode[code] || OTHER; }

      var fmt = function (n) { return 'GEL ' + Math.round(n).toLocaleString('en-US'); };
      var pct = function (r) { return (r * 100).toString().replace(/\.0+$/, '') + '%'; };
      var rangeTxt = function (lo, hi) {
        if (Math.round(lo) === Math.round(hi)) return fmt(lo);
        return fmt(lo) + ' – ' + fmt(hi);
      };

      // region <option>s
      var muniOpts = MUNIS.map(function (m) { return '<option value="' + m.code + '">' + m.name + '</option>'; }).join('')
        + '<option value="__other" selected>Other / I don’t know</option>';

      var incomeSel = document.getElementById('pt-income');
      var yearSel = document.getElementById('pt-year');
      var incomeSrc = document.getElementById('pt-income-src');
      var list = document.getElementById('pt-assets');
      var summary = document.getElementById('pt-summary');
      var summaryBody = document.getElementById('pt-summary-body');

      function yearBounds() {
        var y = parseInt(yearSel.value, 10);
        var start = Date.UTC(y, 0, 1), end = Date.UTC(y, 11, 31);
        var days = (end - start) / 86400000 + 1; // 365 or 366
        return { start: start, end: end, days: days, y: y };
      }
      // fraction of the tax year the asset was owned
      function ownFraction(buyStr, soldChecked, saleStr) {
        var yb = yearBounds();
        var start = buyStr ? Date.parse(buyStr) : yb.start;
        var end = (soldChecked && saleStr) ? Date.parse(saleStr) : yb.end;
        if (isNaN(start)) start = yb.start;
        if (isNaN(end)) end = yb.end;
        if (start < yb.start) start = yb.start;
        if (end > yb.end) end = yb.end;
        if (end < start) return 0;
        var days = (end - start) / 86400000 + 1;
        if (days < 0) days = 0;
        if (days > yb.days) days = yb.days;
        return days / yb.days;
      }

      function assetRow() {
        var row = document.createElement('div');
        row.className = 'as-row';
        row.innerHTML =
          '<div class="as-grid">' +
            '<label>Property type<select class="f-type">' +
              '<option value="re">Real estate</option>' +
              '<option value="car">Car</option>' +
              '<option value="boat">Yacht / motorboat</option>' +
              '<option value="air">Aircraft / helicopter</option>' +
              '<option value="land">Land</option>' +
            '</select></label>' +
            '<label>Region / municipality<select class="f-region">' + muniOpts + '</select></label>' +
            '<label>Purchase date<input type="date" class="f-buy"></label>' +
            '<label class="f-sold-wrap"><span>Sold during the year?</span>' +
              '<span class="as-check"><input type="checkbox" class="f-sold"><input type="date" class="f-saledate" hidden></span></label>' +
            '<label class="f-value-wrap">Market value (GEL)<input type="number" class="f-value" min="0" step="1000" inputmode="numeric" placeholder="e.g. 250000"></label>' +
            '<label class="f-landkind-wrap" hidden>Land type<select class="f-landkind"><option value="nonag">Non-agricultural</option><option value="ag">Agricultural</option></select></label>' +
            '<label class="f-size-wrap" hidden>Area<span class="as-size"><input type="number" class="f-size" min="0" step="0.01" inputmode="decimal" placeholder="e.g. 600"><select class="f-unit"><option value="m2">m²</option><option value="ha">hectares</option></select></span></label>' +
            '<label class="f-agrate-wrap" hidden>Base rate /ha (GEL 5–100, optional)<input type="number" class="f-agrate" min="5" max="100" step="1" inputmode="numeric" placeholder="blank = 5–100"></label>' +
          '</div>' +
          '<div class="as-foot"><span class="as-amount"></span><button type="button" class="as-remove">Remove</button></div>';

        var type = row.querySelector('.f-type');
        var sold = row.querySelector('.f-sold');
        var saledate = row.querySelector('.f-saledate');
        var landkind = row.querySelector('.f-landkind');

        function syncType() {
          var isLand = type.value === 'land';
          row.querySelector('.f-value-wrap').hidden = isLand;
          row.querySelector('.f-landkind-wrap').hidden = !isLand;
          row.querySelector('.f-size-wrap').hidden = !isLand;
          row.querySelector('.f-agrate-wrap').hidden = !(isLand && landkind.value === 'ag');
          // sensible default unit per land kind
          if (isLand) {
            var unit = row.querySelector('.f-unit');
            unit.value = landkind.value === 'ag' ? 'ha' : 'm2';
          }
        }
        type.addEventListener('change', function () { syncType(); recompute(); });
        landkind.addEventListener('change', function () { syncType(); recompute(); });
        sold.addEventListener('change', function () { saledate.hidden = !sold.checked; recompute(); });
        row.addEventListener('input', recompute);
        row.querySelector('.as-remove').addEventListener('click', function () {
          row.remove();
          if (!list.querySelector('.as-row')) addRow();
          recompute();
        });
        syncType();
        return row;
      }

      function addRow() { list.appendChild(assetRow()); }

      // compute one asset -> {cat:'property'|'land'|null, exempt, lo, hi, label, note}
      function computeAsset(row) {
        var type = row.querySelector('.f-type').value;
        var m = muni(row.querySelector('.f-region').value);
        var buy = row.querySelector('.f-buy').value;
        var sold = row.querySelector('.f-sold').checked;
        var saleStr = row.querySelector('.f-saledate').value;
        var f = ownFraction(buy, sold, saleStr);
        var fTxt = f < 0.999 ? ' × ' + Math.round(f * 100) + '% of the year' : '';
        var incomeLow = incomeSel.value === 'le';

        if (type === 'land') {
          var kind = row.querySelector('.f-landkind').value;
          var size = parseFloat(row.querySelector('.f-size').value);
          var unit = row.querySelector('.f-unit').value;
          if (!isFinite(size) || size <= 0) return null;
          if (kind === 'nonag') {
            var m2 = unit === 'ha' ? size * 10000 : size;
            var base = m2 * 0.24;
            var lo = base * m.landMin * f, hi = base * m.landMax * f;
            var coefTxt = (m.landMin === m.landMax) ? ('coefficient ' + m.landMin) : ('coefficient ' + m.landMin + '–' + m.landMax + ' (varies by zone)');
            return { cat: 'land', exempt: false, lo: lo, hi: hi,
              label: 'Non-agricultural land, ' + m.name,
              note: 'GEL 0.24/m² × ' + Math.round(m2).toLocaleString('en-US') + ' m² × ' + coefTxt + fTxt + '.' };
          } else {
            var ha = unit === 'm2' ? size / 10000 : size;
            var rate = parseFloat(row.querySelector('.f-agrate').value);
            var loR, hiR, rTxt;
            if (isFinite(rate) && rate >= 5 && rate <= 100) { loR = rate; hiR = rate; rTxt = 'GEL ' + rate + '/ha'; }
            else { loR = 5; hiR = 100; rTxt = 'GEL 5–100/ha (base rate unknown)'; }
            var alo = ha * loR * 1.0 * f, ahi = ha * hiR * 1.5 * f;
            return { cat: 'land', exempt: false, lo: alo, hi: ahi,
              label: 'Agricultural land, ' + m.name,
              note: (Math.round(ha * 100) / 100).toLocaleString('en-US') + ' ha × ' + rTxt + ' × coefficient up to 1.5' + fTxt + '. Per-ha rates are set by land type in the municipal decree.' };
          }
        }

        // taxable property: real estate / car / boat / aircraft
        var labels = { re: 'Real estate', car: 'Car', boat: 'Yacht / motorboat', air: 'Aircraft / helicopter' };
        var val = parseFloat(row.querySelector('.f-value').value);
        if (!isFinite(val) || val <= 0) return null;
        if (incomeLow) {
          return { cat: 'property', exempt: true, lo: 0, hi: 0,
            label: labels[type] + ', ' + m.name,
            note: 'family income GEL 100,000 or less.' };
        }
        if (m.propertyRate) {
          var p = val * m.propertyRate * f;
          return { cat: 'property', exempt: false, lo: p, hi: p,
            label: labels[type] + ', ' + m.name,
            note: fmt(val) + ' × ' + pct(m.propertyRate) + ' (' + m.name + ' rate)' + fTxt + '.' };
        }
        return { cat: 'property', exempt: false, lo: val * 0.008 * f, hi: val * 0.01 * f,
          label: labels[type] + ', ' + m.name,
          note: fmt(val) + ' × 0.8%–1% (municipality sets the exact rate)' + fTxt + '.' };
      }

      function recompute() {
        var rows = Array.prototype.slice.call(list.querySelectorAll('.as-row'));
        var propLo = 0, propHi = 0, landLo = 0, landHi = 0, anyProp = false, anyLand = false, anyExempt = false, counted = 0;
        rows.forEach(function (row) {
          var r = computeAsset(row);
          var amt = row.querySelector('.as-amount');
          if (!r) { amt.textContent = ''; return; }
          counted++;
          if (r.exempt) { amt.innerHTML = '<span class="as-ok">Exempt</span> — ' + r.note; anyExempt = true; anyProp = true; return; }
          amt.innerHTML = '<strong>' + rangeTxt(r.lo, r.hi) + '</strong> / year — ' + r.note;
          if (r.cat === 'property') { propLo += r.lo; propHi += r.hi; anyProp = true; }
          else { landLo += r.lo; landHi += r.hi; anyLand = true; }
        });

        if (counted === 0) { summary.hidden = true; return; }
        var html = '';
        if (anyProp) {
          html += '<div class="pt-line"><span>Property tax (real estate, cars, yachts, aircraft)</span><span>' +
            ((propLo === 0 && propHi === 0 && incomeSel.value === 'le') ? 'Exempt' : rangeTxt(propLo, propHi)) + '</span></div>';
        }
        if (anyLand) {
          html += '<div class="pt-line"><span>Land tax</span><span>' + rangeTxt(landLo, landHi) + '</span></div>';
        }
        var totLo = propLo + landLo, totHi = propHi + landHi;
        html += '<div class="pt-line pt-line--total"><span>Total estimate</span><span>' + rangeTxt(totLo, totHi) + ' / year</span></div>';
        summaryBody.innerHTML = html;
        summary.hidden = false;
      }

      function updateIncomeSrc() {
        incomeSrc.innerHTML = incomeSel.value === 'le'
          ? 'Real estate and vehicles are exempt at this income level. Land tax still applies — add any land below.'
          : 'Real estate and vehicles are taxed at 0.8%–1% of market value (your municipality sets the exact rate).';
      }
      incomeSel.addEventListener('change', function () { updateIncomeSrc(); recompute(); });
      yearSel.addEventListener('change', recompute);
      document.getElementById('pt-add').addEventListener('click', function () { addRow(); });

      updateIncomeSrc();
      addRow(); // start with one asset
    })();
  </script>

  <style>
    .pt-muni { margin: 16px 0; padding: 14px 16px; background: var(--navy); color: #fff; max-width: 46em; }
    .pt-global { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
    .pt-muni label { display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
    .pt-muni select { padding: 9px 11px; font: inherit; border: 1px solid var(--grey-2); background: #fff; color: var(--black); }
    .pt-muni-src { margin: 10px 0 0; font-size: 13px; opacity: 0.92; }

    .as-row { margin: 14px 0; padding: 14px 16px; background: var(--grey-3); border: 1px solid var(--grey-4); max-width: 46em; }
    .as-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
    .as-grid > label { display: flex; flex-direction: column; gap: 5px; font-size: 14px; font-weight: 600; }
    .as-grid input, .as-grid select { padding: 9px 11px; font: inherit; border: 1px solid var(--grey-2); background: #fff; color: var(--black); }
    .as-check { display: flex; align-items: center; gap: 10px; }
    .as-check input[type=checkbox] { width: 18px; height: 18px; }
    .as-size { display: flex; gap: 8px; }
    .as-size input { flex: 1 1 auto; min-width: 0; }
    .as-size select { flex: 0 0 auto; }
    .as-foot { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--grey-2); }
    .as-amount { font-size: 14px; color: var(--grey-1); }
    .as-amount strong { color: var(--black); font-size: 16px; }
    .as-ok { font-family: var(--font-mono); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; color: #fff; background: var(--green); padding: 2px 8px; }
    .as-remove { font: inherit; font-size: 13px; padding: 5px 12px; border: 1px solid var(--grey-2); background: #fff; color: var(--black); cursor: pointer; }
    .as-remove:hover { background: var(--grey-3); }

    .pt-add { font: inherit; font-weight: 600; padding: 10px 18px; margin: 4px 0 8px; border: 1px solid var(--navy); background: var(--navy); color: #fff; cursor: pointer; }
    .pt-add:hover { opacity: .9; }

    .pt-card { margin: 18px 0; padding: 16px 18px; background: var(--grey-3); border: 1px solid var(--grey-4); max-width: 46em; }
    .pt-card h2 { margin: 0 0 6px; font-size: 20px; }
    .pt-summary { background: var(--navy); color: #fff; border-color: var(--navy); }
    .pt-line { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.2); font-size: 15px; }
    .pt-line--total { border-bottom: 0; font-weight: 700; font-size: 18px; padding-top: 12px; }

    .pt-foot-note { max-width: 46em; font-size: 15px; color: var(--grey-1); }
    .sources { max-width: 46em; }
    .sources ul { margin: 8px 0 0; padding-inline-start: 20px; }
    .tool-foot { margin-top: 30px; padding-top: 16px; border-top: 1px solid var(--grey-2); color: var(--grey-1); font-size: 15px; max-width: 46em; }
    html[data-theme='dark'] .as-grid input, html[data-theme='dark'] .as-grid select,
    html[data-theme='dark'] .pt-muni select, html[data-theme='dark'] .as-remove { background: #1b1b1b; color: #fff; }
    @media (max-width: 520px) { .pt-global, .as-grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
