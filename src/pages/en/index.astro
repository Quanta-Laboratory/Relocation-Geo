---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('guides', ({ data }) => data.lang === 'en' && !data.draft);
// Only top-level pages appear on the homepage. Pages that declare a `parent`
// are nested under their pillar page and are reachable from there.
// "Georgia in Numbers" is featured at the top of the page, so it is excluded
// from the hub lists below (it would otherwise appear under About).
const featuredSlugs = ['georgia-in-numbers'];
const byCat = (c: string) =>
  all
    .filter(
      (e) =>
        e.data.category === c &&
        !e.data.parent &&
        !featuredSlugs.includes(e.id.replace(/^en\//, '')),
    )
    .sort((a, b) => a.data.order - b.data.order);
const link = (e: { id: string }) => `/en/${e.id.replace(/^en\//, '')}`;

const hubs = [
  { id: 'immigration', title: 'Immigration & Visa', desc: 'Entry rules, visas, legal status and all residence permit types.' },
  { id: 'work', title: 'Work & Business', desc: 'Running a business, the Individual Entrepreneur, companies and special statuses.' },
  { id: 'tax', title: 'Taxes', desc: 'Tax residency, personal income tax, territorial taxation, crypto and double-tax treaties.' },
  { id: 'students', title: 'Study in Georgia', desc: 'Choosing a university, admissions, student visa, funding — and studying medicine.' },
  { id: 'live', title: 'Live in Georgia', desc: 'Housing, health and insurance, and the everyday essentials of daily life.' },
  { id: 'about', title: 'About', desc: 'Methodology, standards and legal information.' },
];

// Line icons — 24px grid, 1.75px stroke, square caps, no fills (brand iconography).
const iconAttrs = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"';
const icons: Record<string, string> = {
  immigration: `<svg ${iconAttrs}><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 12h6"/><path d="M9 16h6"/></svg>`,
  work: `<svg ${iconAttrs}><rect x="3" y="7" width="18" height="13"/><path d="M8 7V5h8v2"/><path d="M3 12h18"/></svg>`,
  tax: `<svg ${iconAttrs}><circle cx="8" cy="8" r="2.25"/><circle cx="16" cy="16" r="2.25"/><path d="M6 18 18 6"/></svg>`,
  students: `<svg ${iconAttrs}><path d="M12 4 22 9l-10 5L2 9z"/><path d="M6 11v5c0 1.2 2.7 2.5 6 2.5s6-1.3 6-2.5v-5"/></svg>`,
  live: `<svg ${iconAttrs}><path d="M4 11 12 4l8 7"/><path d="M6 10v10h12V10"/></svg>`,
  about: `<svg ${iconAttrs}><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/></svg>`,
};
---
<BaseLayout
  title={null}
  description="Relocation.ge organises official Georgian legal provisions into clear, source-based guidance on visas, residence permits, business, taxes and daily life."
>
  <main id="main" class="wrap">
    <p class="kicker">Open-source guidance</p>
    <h1>Relocation to Georgia</h1>
    <p class="lede">
      Relocation.ge is a public, open-source project that organises official Georgian
      legal provisions into clear, source-based guidance on visas, residence permits,
      business, taxes and daily life — for international audiences.
    </p>

    <aside class="notice-banner" role="region" aria-label="Important legal changes in 2026">
      <p class="notice-banner__title">Important — 2026 legal changes</p>
      <div class="notice-banner__content">
        <p class="notice-banner__lead">Several rules that affect foreigners changed in 2026. The key ones:</p>
        <ul class="notice-list">
          <li>
            <strong>Right to work is now separate from your residence permit.</strong>
            After the 2026 labour-migration reform, a residence permit alone no longer lets you work —
            you need a distinct work authorisation from the Ministry of Labour. People already registered
            by 1 March 2026 must obtain it, plus a matching residence permit, by 1 January 2027.
            <a href="/en/right-to-work-georgia">The right to work explained →</a>
          </li>
          <li>
            <strong>New D6 visa for minor students, from 1 September 2026.</strong>
            Minors who study move to the new D6 immigration visa, which also covers their parents or
            legal representatives and minor siblings; the D3 visa is narrowed to adult students and researchers.
            <a href="/en/d6-visa-georgia">About the D6 visa →</a>
          </li>
          <li>
            <strong>Residence by property now needs USD 150,000, up from USD 100,000.</strong>
            The short-term residence permit based on real-estate ownership now requires non-agricultural
            property valued above USD 150,000 (by certified valuation, not purchase price).
            <a href="/en/short-term-residence-permit-property-georgia">Residence permit by property →</a>
          </li>
        </ul>
      </div>
    </aside>

    <section class="home-stats" aria-label="Georgia at a glance">
      <h2 class="home-stats__title">Georgia at a glance</h2>
      <p class="home-stats__intro">
        The economy, population and trade in a snapshot. Full picture in
        <a href="/en/georgia-in-numbers"><strong>Georgia in Numbers</strong></a>.
      </p>
      <div class="stat-cards">
        <div class="stat-card"><div class="stat-card__value">~3.9m</div><div class="stat-card__label">Population</div><div class="stat-card__note">Geostat, 2024 census</div></div>
        <div class="stat-card"><div class="stat-card__value">~$34bn</div><div class="stat-card__label">Nominal GDP</div><div class="stat-card__note">Geostat, 2024</div></div>
        <div class="stat-card"><div class="stat-card__value">~$28,000</div><div class="stat-card__label">GDP per capita (PPP)</div><div class="stat-card__note">IMF/World Bank, 2024</div></div>
        <div class="stat-card"><div class="stat-card__value">9.7%</div><div class="stat-card__label">Real GDP growth</div><div class="stat-card__note">Geostat, 2024</div></div>
        <div class="stat-card"><div class="stat-card__value">~1.1%</div><div class="stat-card__label">Inflation (avg)</div><div class="stat-card__note">Geostat, 2024</div></div>
        <div class="stat-card"><div class="stat-card__value">#35</div><div class="stat-card__label">Economic-freedom rank</div><div class="stat-card__note">Heritage, 2025</div></div>
      </div>
    </section>

    <a href="#immigration" class="start-button">
      Start now
      <svg width="18" height="18" viewBox="0 0 33 40" fill="currentColor" aria-hidden="true">
        <path d="M0 0h13l20 20-20 20H0l20-20z" />
      </svg>
    </a>

    <div class="grid">
      {hubs.map((h) => (
        <section class="hub" id={h.id}>
          <h2><span class="hub__icon" set:html={icons[h.id]} />{h.title}</h2>
          <p class="desc">{h.desc}</p>
          {h.id === 'students' && (
            <p class="hub-note">
              <span class="hub-note__tag">New</span>
              <span>From 1 Sep 2026, minor students use the new <a href="/en/d6-visa-georgia">D6 visa</a> (adults keep D3).</span>
            </p>
          )}
          {h.id === 'work' && (
            <p class="hub-note">
              <span class="hub-note__tag">New</span>
              <span>Since the 2026 reform, most work needs a separate <a href="/en/right-to-work-georgia">right to work</a> — a residence permit alone is no longer enough.</span>
            </p>
          )}
          {h.id === 'immigration' && (
            <p class="hub-note">
              <span class="hub-note__tag">Tool</span>
              <span>Not sure how you would enter? Try the interactive <a href="/en/georgia-entry-checker">Georgia Entry Checker</a>.</span>
            </p>
          )}
          <ul>
            {byCat(h.id).length === 0 && <li style="color:var(--grey-1)">Coming soon</li>}
            {byCat(h.id).map((e) => (
              <li><a href={link(e)}>{e.data.title}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="sources">
      <h2>Sources</h2>
      <p style="color:var(--grey-1)">Information on this website is structured from official publications, including:</p>
      <ul>
        <li>Matsne — Legislative Herald of Georgia</li>
        <li>Ministry of Internal Affairs of Georgia</li>
        <li>Revenue Service of Georgia</li>
        <li>Public Service Hall</li>
      </ul>
    </div>
  </main>
</BaseLayout>
