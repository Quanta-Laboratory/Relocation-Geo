---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DateStamp from '../components/DateStamp.astro';
import { getCollection } from 'astro:content';
import { ui, dirFor, localeFor, LANGS } from '../i18n/ui';

const { entry, headings = [] } = Astro.props;
const d = entry.data;

const lang = d.lang;
const t = ui(lang);

// Strip the language prefix (any of the known codes) to get the base slug.
const stripLang = (id: string) => id.replace(/^[a-z]{2}\//, '');
const slug = stripLang(entry.id);
const childLink = (e: { id: string }) => `/${lang}/${stripLang(e.id)}`;

// Sibling pages in the same language, used to build the two-level hierarchy:
// children of this page (for the "In this section" index) and this page's
// parent pillar (for the breadcrumb trail).
const siblings = await getCollection(
  'guides',
  ({ data }) => data.lang === lang && !data.draft
);
const children = siblings
  .filter((e) => e.data.parent === slug)
  .sort((a, b) => a.data.order - b.data.order);
const parentEntry = d.parent
  ? siblings.find((e) => stripLang(e.id) === d.parent)
  : null;

// Cross-language versions of this same page, for the header switcher and
// hreflang alternates. One entry per language that has this base slug.
const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const translations = LANGS.map((l) => {
  const match = allGuides.find(
    (e) => e.data.lang === l.code && stripLang(e.id) === slug
  );
  if (!match) return null;
  return {
    code: l.code,
    native: l.native,
    href: `/${l.code}/${slug}`,
    active: l.code === lang,
  };
}).filter((x): x is NonNullable<typeof x> => x !== null);

const catLabels = t.categories;
const catHref: Record<string, string> = {
  immigration: `/${lang}/#immigration`,
  work: `/${lang}/#work`,
  tax: `/${lang}/#tax`,
  students: `/${lang}/#students`,
  live: `/${lang}/#live`,
  about: `/${lang}/#about`,
};

const crumbs = [
  { href: `/${lang}/`, label: t.home },
  { href: catHref[d.category], label: catLabels[d.category] },
  ...(parentEntry
    ? [{ href: `/${lang}/${d.parent}`, label: parentEntry.data.title }]
    : []),
  { label: d.title },
];

const siteUrl = Astro.site ? String(Astro.site) : 'https://relocation.ge';
const url = new URL(Astro.url.pathname, siteUrl).href;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  inLanguage: d.lang,
  dateModified: new Date(d.reviewed).toISOString(),
  url,
  isPartOf: { '@type': 'WebSite', name: 'Relocation.ge', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'Relocation.ge' },
  citation: d.sources.map((s: { name: string; url: string }) => ({
    '@type': 'CreativeWork',
    name: s.name,
    url: s.url,
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: c.href ? new URL(c.href, siteUrl).href : url,
  })),
};
const faqLd =
  d.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faq.map((f: { q: string; a: string }) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const jsonLd = [articleLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];
const toc = headings.filter((h: { depth: number }) => h.depth === 2);
---
<BaseLayout
  title={d.title}
  description={d.summary}
  lang={lang}
  dir={dirFor(lang)}
  translations={translations}
  languageLabel={t.language}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <main id="main" class="wrap">
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <p class="status-tags">
      <span class="status-tag status-tag--verified">Verified {new Date(d.reviewed).getUTCFullYear()}</span>
    </p>
    <DateStamp
      reviewed={d.reviewed}
      checked={d.checked}
      locale={localeFor(lang)}
      reviewedLabel={t.reviewed}
      checkedLabel={t.checked}
    />

    <div class="cols">
      <nav class="contents" aria-label={t.contents}>
        <h2>{t.contents}</h2>
        <ol>
          {toc.map((h: { slug: string; text: string }) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>

      <div class="prose">
        {children.length > 0 && (
          <nav class="in-section" aria-label={t.inThisSection}>
            <h2>{t.inThisSection}</h2>
            <ul>
              {children.map((e) => (
                <li>
                  <a href={childLink(e)}>{e.data.title}</a>
                  <span class="in-section__sum">{e.data.summary}</span>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <slot />

        {d.faq.length > 0 && (
          <section class="faq" aria-label={t.faqHeading}>
            <h2>{t.faqHeading}</h2>
            {d.faq.map((f: { q: string; a: string }) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        {d.sources.length > 0 && (
          <div class="sources">
            <h2>{t.sources}</h2>
            <ul>
              {d.sources.map((s: { name: string; url: string }) => (
                <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a></li>
              ))}
            </ul>
          </div>
        )}

        <div class="feedback">
          <h2>{t.usefulHeading}</h2>
          <p><a href="#">{t.yes}</a> · <a href="#">{t.no}</a></p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* "In this section" — auto-generated index of child pages on a pillar page. */
  .in-section {
    margin: 0 0 30px;
    padding: 15px 20px;
    background: var(--grey-3);
  }
  .in-section h2 {
    margin: 0 0 12px;
    font-size: 18px;
  }
  .in-section ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .in-section li {
    margin: 0;
  }
  .in-section a {
    font-weight: 700;
    font-size: 17px;
  }
  .in-section__sum {
    display: block;
    margin-top: 3px;
    font-size: 15px;
    color: var(--grey-1);
  }

  /* On mobile the two-column grid collapses to one column; the sticky
     Contents nav would otherwise overlap the article text as you scroll.
     Higher specificity (.cols .contents) overrides the base sticky rule. */
  @media (max-width: 740px) {
    .cols .contents {
      position: static;
      top: auto;
      margin-bottom: 30px;
    }
  }
</style>
