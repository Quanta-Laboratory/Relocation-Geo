---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DateStamp from '../components/DateStamp.astro';
import { getCollection } from 'astro:content';

const { entry, headings = [] } = Astro.props;
const d = entry.data;

const slug = entry.id.replace(/^en\//, '');
const childLink = (e: { id: string }) => `/en/${e.id.replace(/^en\//, '')}`;

// Sibling pages in the same language, used to build the two-level hierarchy:
// children of this page (for the "In this section" index) and this page's
// parent pillar (for the breadcrumb trail).
const siblings = await getCollection(
  'guides',
  ({ data }) => data.lang === d.lang && !data.draft
);
const children = siblings
  .filter((e) => e.data.parent === slug)
  .sort((a, b) => a.data.order - b.data.order);
const parentEntry = d.parent
  ? siblings.find((e) => e.id.replace(/^en\//, '') === d.parent)
  : null;

const catLabels: Record<string, string> = {
  immigration: 'Immigration & Visa',
  work: 'Work & Business',
  tax: 'Taxes',
  students: 'Study in Georgia',
  live: 'Live in Georgia',
  about: 'About',
};
const catHref: Record<string, string> = {
  immigration: '/en/#immigration',
  work: '/en/#work',
  tax: '/en/#tax',
  students: '/en/#students',
  live: '/en/#live',
  about: '/en/#about',
};

const crumbs = [
  { href: '/en/', label: 'Home' },
  { href: catHref[d.category], label: catLabels[d.category] },
  ...(parentEntry
    ? [{ href: `/en/${d.parent}`, label: parentEntry.data.title }]
    : []),
  { label: d.title },
];

const siteUrl = Astro.site ? String(Astro.site) : 'https://relocation.ge';
const url = new URL(Astro.url.pathname, siteUrl).href;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  inLanguage: d.lang,
  dateModified: new Date(d.reviewed).toISOString(),
  url,
  isPartOf: { '@type': 'WebSite', name: 'Relocation.ge', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'Relocation.ge' },
  citation: d.sources.map((s: { name: string; url: string }) => ({
    '@type': 'CreativeWork',
    name: s.name,
    url: s.url,
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: c.href ? new URL(c.href, siteUrl).href : url,
  })),
};
const faqLd =
  d.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faq.map((f: { q: string; a: string }) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const jsonLd = [articleLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];
const toc = headings.filter((h: { depth: number }) => h.depth === 2);
---
<BaseLayout title={d.title} description={d.summary} lang={d.lang} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <main id="main" class="wrap">
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <DateStamp reviewed={d.reviewed} checked={d.checked} />

    <div class="cols">
      <nav class="contents" aria-label="Contents">
        <h2>Contents</h2>
        <ol>
          {toc.map((h: { slug: string; text: string }) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>

      <div class="prose">
        {children.length > 0 && (
          <nav class="in-section" aria-label="In this section">
            <h2>In this section</h2>
            <ul>
              {children.map((e) => (
                <li>
                  <a href={childLink(e)}>{e.data.title}</a>
                  <span class="in-section__sum">{e.data.summary}</span>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <slot />

        {d.faq.length > 0 && (
          <section class="faq" aria-label="Frequently asked questions">
            <h2>Frequently asked questions</h2>
            {d.faq.map((f: { q: string; a: string }) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        {d.sources.length > 0 && (
          <div class="sources">
            <h2>Sources</h2>
            <ul>
              {d.sources.map((s: { name: string; url: string }) => (
                <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a></li>
              ))}
            </ul>
          </div>
        )}

        <div class="feedback">
          <h2>Is this page useful?</h2>
          <p><a href="#">Yes</a> · <a href="#">No</a></p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* "In this section" — auto-generated index of child pages on a pillar page. */
  .in-section {
    margin: 0 0 30px;
    padding: 15px 20px;
    background: var(--grey-3);
  }
  .in-section h2 {
    margin: 0 0 12px;
    font-size: 18px;
  }
  .in-section ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .in-section li {
    margin: 0;
  }
  .in-section a {
    font-weight: 700;
    font-size: 17px;
  }
  .in-section__sum {
    display: block;
    margin-top: 3px;
    font-size: 15px;
    color: var(--grey-1);
  }

  /* On mobile the two-column grid collapses to one column; the sticky
     Contents nav would otherwise overlap the article text as you scroll.
     Higher specificity (.cols .contents) overrides the base sticky rule. */
  @media (max-width: 740px) {
    .cols .contents {
      position: static;
      top: auto;
      margin-bottom: 30px;
    }
  }
</style>
